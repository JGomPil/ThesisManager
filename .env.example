# =============================================================================
# Thesis Manager · variables de entorno
# Copiar a .env.local (ignorado por Git) y rellenar.
#
# Todo lo que empieza por VITE_ se incrusta en el bundle y es PÚBLICO.
# Nunca pongas aquí una clave privilegiada.
# =============================================================================

# URL del proyecto de Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave anon / publishable. Es pública por diseño: la protección real la ejerce
# Row Level Security en PostgreSQL, no el secreto de esta clave.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Prefijo de rutas. En local '/'; en GitHub Pages lo inyecta deploy.yml
# como /ThesisManager/
VITE_BASE_PATH=/

# -----------------------------------------------------------------------------
# NUNCA en este fichero ni en ninguno del repositorio:
#   SUPABASE_SERVICE_ROLE_KEY   → otorga acceso total saltándose RLS
#   credenciales SMTP           → van en el panel de Supabase
#   claves de API de IA         → van en los secrets de Edge Functions (Fase 6)
# -----------------------------------------------------------------------------
