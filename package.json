{
  "name": "thesis-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gesti\u00f3n y supervisi\u00f3n de trabajos acad\u00e9micos (GIB-UVa)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "cp dist/index.html dist/404.html && touch dist/.nojekyll",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:rls": "./scripts/test-rls.sh",
    "check:secrets": "./scripts/check-no-secrets.sh dist",
    "types:db": "supabase gen types typescript --local > src/data/types/database.ts",
    "check:embeds": "bash scripts/check-embeds.sh",
    "check:export": "./scripts/check-export-queries.sh",
    "drill": "./scripts/restore-drill.sh",
    "check:wrap": "./scripts/check-text-wrap.sh",
    "check:pure": "./scripts/check-pure-tests.sh",
    "check:pwa": "./scripts/check-pwa.sh",
    "icons": "python3 scripts/make-icons.py"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.56.2",
    "@tanstack/react-table": "^8.20.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
